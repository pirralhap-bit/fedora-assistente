[Unit]
Description=Fedora — assistente local (ouve "Ok, Fedora")
Wants=whisper.service
After=whisper.service pipewire.service graphical-session.target
PartOf=graphical-session.target

[Service]
WorkingDirectory=%h/Projetos/jarvis
ExecStart=%h/Projetos/jarvis/.venv/bin/python3 %h/Projetos/jarvis/server.py
Restart=on-failure

[Install]
WantedBy=graphical-session.target
