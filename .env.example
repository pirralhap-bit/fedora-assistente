# Copie para .env e preencha. Nunca coloque segredo neste arquivo de exemplo.

# ── Gemini (atalhos rapidos e organizar a nota) ────────────────
GEMINI_API_KEY=
# Modelos para a nota/tidy (lista separada por virgula = tenta em ordem) e para o atalho rapido
# GEMINI_MODEL=gemini-3-flash-preview,gemini-3.5-flash
# GEMINI_MODEL_RAPIDO=gemini-3.1-flash-lite

# ── Cerebro (claude CLI, assinatura; nunca use --bare) ─────────
# JARVIS_MODEL=opus
# CLAUDE_CMD=C:/caminho/para/claude.cmd
# bypassPermissions (padrao) age sem confirmar; a lista DENY em runtime.py e um freio, nao um sandbox
# (veja "Seguranca" no README). acceptEdits restringe a edicoes.
JARVIS_PERMISSION=bypassPermissions
JARVIS_WORKDIR=~
JARVIS_TIMEOUT=180

# ── Vault e servidor ───────────────────────────────────────────
# JARVIS_VAULT=C:/caminho/do/vault
JARVIS_PORT=8720
# 1 abre a janela ao subir; 0 nao abre
JARVIS_OPEN=1

# ── Ouvido (push-to-talk) e STT ────────────────────────────────
# FEDORA_HOTKEY=ctrl+alt+space
# FEDORA_EAR=1           # 0 = sem ouvido
# FEDORA_ORB=1           # 0 = sem o buraco negro flutuante
# ASSISTANT_NAME=Fedora
# FEDORA_APP_CMD="C:/caminho/msedge.exe" --app={url}
# WHISPER_URL=http://127.0.0.1:8178/inference
# WHISPER_PORT=8178
# nome do modelo do faster-whisper (small, medium, large-v3-turbo...)
# WHISPER_MODEL=small
# WHISPER_LANG=pt

# ── Voz (Piper) ────────────────────────────────────────────────
# PIPER_BIN=C:/caminho/piper.exe
# PIPER_VOICE=C:/caminho/pt_BR-faber-medium.onnx

# ── Conversa e modo leve ───────────────────────────────────────
# FEDORA_CONVERSA=C:/caminho/conversa.md
# FEDORA_JANELA=900        # segundos ate abrir sessao nova (0 = nunca)
# FEDORA_MAX_TURNOS=10
# FEDORA_MODO_LEVE=1       # 0 = sempre o Claude Code completo

# ── Registro por turno e retrospectiva ─────────────────────────
# FEDORA_TURNLOG=C:/caminho/turnos.jsonl
# FEDORA_RETRO=1           # 0 = sem retrospectiva semanal

# ── Atalhos ────────────────────────────────────────────────────
# FEDORA_CIDADE=Sao Paulo,-23.550,-46.633
# STEAM_DIR=C:/Program Files (x86)/Steam
