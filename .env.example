# Copie para .env e preencha. Nunca coloque segredo neste arquivo de exemplo.

# ── Gemini (atalhos rapidos e organizar a nota) ────────────────
GEMINI_API_KEY=
# Modelos para a nota/tidy (lista separada por virgula = tenta em ordem) e para o atalho rapido
# GEMINI_MODEL=gemini-3-flash-preview,gemini-3.5-flash
# GEMINI_MODEL_RAPIDO=gemini-3.1-flash-lite

# ── Cerebro (claude CLI, assinatura; nunca use --bare) ─────────
# JARVIS_MODEL=opus
# modelo so do turno leve de voz (vazio = JARVIS_MODEL); completo, equipe e chat seguem o JARVIS_MODEL
# FEDORA_MODEL_LEVE=sonnet
# CLAUDE_CMD=C:/caminho/para/claude.cmd
# bypassPermissions (padrao) age sem confirmar; a lista DENY em runtime.py e um freio, nao um sandbox
# (veja "Seguranca" no README). acceptEdits restringe a edicoes.
JARVIS_PERMISSION=bypassPermissions

# ── Motor (qual assinatura responde) ───────────────────────────
# Claude (primario) e agy (Antigravity/Google, motor_agy.py). Mesma autonomia; as travas da lista DENY viram
# permissions.deny do agy a cada turno (se a traducao falhar, o agy nao inicia). Veja docs/MOTORES.md.
# auto (padrao): Claude, e o agy (motor e agentes) quando o Claude passa de 55% na SEMANA ou chega a 90% na SESSAO de 5 h,
# ate aquela janela resetar. claude|agy forcam um. E so o padrao de boot: "troca o motor pro agy/claude" (voz ou chat)
# grava no motor.json e vence este valor, ate dizer "motor automatico".
# FEDORA_MOTOR=auto
# FEDORA_MOTOR_LIMITE=0.55
# FEDORA_MOTOR_LIMITE_SESSAO=0.90
# AGY_MODEL=gemini-3.8-flash-medium
# AGY_MODEL_COMPLETO=gemini-4-argon-medium
# bypass (padrao: --dangerously-skip-permissions + deny) | auto | plan
# AGY_PERMISSION=bypass
# AGY_CMD=C:/Users/voce/AppData/Local/agy/bin/agy.exe
JARVIS_WORKDIR=~
JARVIS_TIMEOUT=180

# ── Vault e servidor ───────────────────────────────────────────
# JARVIS_VAULT=C:/caminho/do/vault
JARVIS_PORT=8720
# 1 abre a janela ao subir; 0 nao abre
JARVIS_OPEN=1

# ── Ouvido (push-to-talk) e STT ────────────────────────────────
# FEDORA_HOTKEY=ctrl+alt+space
# Segundos de silêncio que encerram um comando de voz (padrão 1.8; aceita 2,5). Inválido cai no padrão.
# Suba se a Fedora cortar quem pausa no meio da frase. O ditado continua fixo em 4 s.
# FEDORA_SILENCIO_COMANDO=1.8
# FEDORA_EAR=1           # 0 = sem ouvido
# FEDORA_ORB=1           # 0 = sem o buraco negro flutuante
# ASSISTANT_NAME=Fedora
# FEDORA_APP_CMD="C:/caminho/msedge.exe" --app={url}
# WHISPER_URL=http://127.0.0.1:8178/inference
# WHISPER_PORT=8178
# nome do modelo do faster-whisper (padrao medium; "small" e trocado por medium no whisper_server.py)
# WHISPER_MODEL=medium
# WHISPER_LANG=pt

# ── Voz (Piper) ────────────────────────────────────────────────
# PIPER_BIN=C:/caminho/piper.exe
# PIPER_VOICE=C:/caminho/pt_BR-faber-medium.onnx

# ── Conversa e modo leve ───────────────────────────────────────
# FEDORA_CONVERSA=C:/caminho/conversa.md
# FEDORA_JANELA=900        # segundos ate abrir sessao nova (0 = nunca)
# FEDORA_MAX_TURNOS=10
# FEDORA_MODO_LEVE=1       # 0 = sempre o Claude Code completo

# ── Registro por turno e retrospectiva ─────────────────────────
# FEDORA_TURNLOG=C:/caminho/turnos.jsonl
# FEDORA_RETRO=1           # 0 = sem retrospectiva semanal

# ── Atalhos ────────────────────────────────────────────────────
# FEDORA_CIDADE=Sao Paulo,-23.550,-46.633
# STEAM_DIR=C:/Program Files (x86)/Steam

# ── Equipe e backlog ───────────────────────────────────────────
# COFRE=C:/caminho/do/vault          # cofre do backlog (padrao: JARVIS_VAULT)
# FEDORA_AGENTE_TIMEOUT=300          # segundos por agente (o despachante espera +90)
# FEDORA_MAX_PASSOS=14               # teto de passos do turno leve (0 desliga)
# FEDORA_SUBSTITUTO_NO_AGY=opus=gemini-argon-high   # troca de modelo com o agy no comando (padrao mantido se vazio)

# ── Diversos ───────────────────────────────────────────────────
# JARVIS_TZ=America/Sao_Paulo
# FEDORA_DEBUG=1                     # log extra do ouvido
# JARVIS_VERBOSE=1                   # log de cada pedido HTTP
